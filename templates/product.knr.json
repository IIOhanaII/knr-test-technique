{
  "layout": "knr",
  "sections": {
    "knr-product-hero": {
      "type": "knr-product-hero",
      "settings": {
        "show_reviews": true,
        "show_scores": true,
        "show_accordions": true,
        "show_complementary": true,
        "complementary_title": "Complétez votre rituel"
      },
      "blocks": {
        "reinsurance": {
          "type": "knr-reinsurance",
          "settings": {
            "message_speed": 4
          },
          "blocks": {
            "reinsurance-1": {
              "type": "knr-reinsurance-message",
              "settings": {
                "text": "En stock, livraison estimée {delivery}."
              }
            },
            "reinsurance-2": {
              "type": "knr-reinsurance-message",
              "settings": {
                "text": "Livraison offerte dès 60 € d'achat."
              }
            },
            "reinsurance-3": {
              "type": "knr-reinsurance-message",
              "settings": {
                "text": "Retours sous 30 jours."
              }
            },
            "reinsurance-4": {
              "type": "knr-reinsurance-message",
              "settings": {
                "text": "Paiement sécurisé."
              }
            }
          },
          "block_order": [
            "reinsurance-1",
            "reinsurance-2",
            "reinsurance-3",
            "reinsurance-4"
          ]
        }
      },
      "block_order": ["reinsurance"]
    },
    "knr-manifesto": {
      "type": "knr-manifesto"
    },
    "knr-how-to-use": {
      "type": "knr-how-to-use",
      "settings": {
        "heading": "How to use"
      }
    },
    "knr-before-after": {
      "type": "knr-before-after"
    },
    "knr-reviews": {
      "type": "knr-reviews"
    }
  },
  "order": [
    "knr-product-hero",
    "knr-manifesto",
    "knr-how-to-use",
    "knr-before-after",
    "knr-reviews"
  ]
}
