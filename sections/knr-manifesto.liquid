{%- liquid
  # Product-specific content from the knr.manifesto metaobject.
  # No fallback: the section renders only when the metaobject is set.
  assign mo = product.metafields.knr.manifesto.value
-%}
{%- if mo != blank -%}
{%- liquid
  assign m_image = mo.image.value
  assign m_eyebrow = mo.eyebrow.value
  assign m_statement = mo.statement.value
  assign m_attribution = mo.attribution.value

  assign current_variant = product.selected_or_first_available_variant
  assign qs_form_id = 'knr-quickshop-' | append: section.id
-%}
<script
  src="{{ 'product-form.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>
<section class="knr-manifesto" data-section-id="{{ section.id }}">
  {%- if m_image != blank -%}
    {{
      m_image
      | image_url: width: 1600
      | image_tag:
        loading: 'lazy',
        width: m_image.width,
        height: m_image.height,
        widths: '750, 1100, 1500, 2000, 2800',
        sizes: '100vw',
        class: 'knr-manifesto__bg',
        alt: m_image.alt | default: m_eyebrow
    }}
  {%- endif -%}
  <div class="knr-manifesto__overlay" aria-hidden="true"></div>

  <div class="knr-manifesto__inner">
    {%- if m_eyebrow != blank -%}
      <div class="knr-manifesto__eyebrow">
        <p class="knr-manifesto__eyebrow-text">{{ m_eyebrow }}</p>
        <span class="knr-manifesto__eyebrow-bar" aria-hidden="true"></span>
      </div>
    {%- endif -%}

    <div class="knr-manifesto__content">
      {%- if m_statement != blank -%}
        <div class="knr-manifesto__statement">
          {%- render 'knr-richtext', value: m_statement -%}
        </div>
      {%- endif -%}
      {%- if m_attribution != blank -%}
        <p class="knr-manifesto__attribution">{{ m_attribution }}</p>
      {%- endif -%}
    </div>
  </div>

  {%- if current_variant -%}
    <div class="knr-manifesto__quickshop" data-knr-quickshop>
      <div class="knr-manifesto__quickshop-product">
        {%- if product.featured_image != blank -%}
          {{
            product.featured_image
            | image_url: width: 208
            | image_tag:
              loading: 'lazy',
              width: 104,
              height: 104,
              widths: '104, 208',
              sizes: '104px',
              class: 'knr-manifesto__quickshop-thumb',
              alt: product.title
          }}
        {%- endif -%}
        <div class="knr-manifesto__quickshop-info">
          <p class="knr-manifesto__quickshop-title">{{ product.title }}</p>
          {%- unless product.has_only_default_variant -%}
            <div class="knr-manifesto__quickshop-variants" role="radiogroup" aria-label="{{ product.options.first }}">
              {%- for variant in product.variants -%}
                <button
                  type="button"
                  class="knr-manifesto__quickshop-variant{% if variant.id == current_variant.id %} is-selected{% endif %}"
                  data-knr-quickshop-variant="{{ variant.id }}"
                  data-knr-quickshop-variant-price="{{ variant.price | money }}"
                  role="radio"
                  aria-checked="{% if variant.id == current_variant.id %}true{% else %}false{% endif %}"
                >
                  {{- variant.title -}}
                </button>
              {%- endfor -%}
            </div>
          {%- endunless -%}
          <p class="knr-manifesto__quickshop-price" data-knr-quickshop-price>
            {{- current_variant.price | money -}}
          </p>
        </div>
      </div>

      <product-form-component
        class="knr-manifesto__quickshop-form"
        data-section-id="{{ section.id }}"
        data-product-id="{{ product.id }}"
        on:submit="/handleSubmit"
      >
        <div
          class="visually-hidden"
          aria-live="assertive"
          role="status"
          aria-atomic="true"
          ref="liveRegion"
        ></div>
        {%- form 'product', product, id: qs_form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
          <input
            type="hidden"
            name="id"
            ref="variantId"
            value="{{ current_variant.id }}"
            data-knr-quickshop-id
          >
          <input type="hidden" name="quantity" value="1">
          <add-to-cart-component>
            <button
              ref="addToCartButton"
              type="submit"
              name="add"
              class="knr-manifesto__quickshop-atc"
              {% unless current_variant.available %}disabled{% endunless %}
            >
              {%- if current_variant.available -%}
                {{ 'products.product.add_to_cart' | t }}
              {%- else -%}
                {{ 'products.product.sold_out' | t }}
              {%- endif -%}
            </button>
          </add-to-cart-component>
        {%- endform -%}
      </product-form-component>
    </div>
  {%- endif -%}
</section>
{%- endif -%}

{% stylesheet %}
  .knr-manifesto {
    position: relative;
    width: 100%;
    background: var(--knr-color-surface-3);
    color: var(--knr-color-white);
    font-family: var(--knr-font-sans);
  }

  .knr-manifesto__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .knr-manifesto__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      -77deg,
      rgba(130, 121, 100, 0) 35%,
      rgb(143, 135, 119) 108%
    );
  }

  .knr-manifesto__inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--knr-space-16);
    min-height: 600px;
    padding: 5rem 1.5rem;
  }

  .knr-manifesto__eyebrow {
    display: flex;
    flex-direction: column;
    gap: var(--knr-space-2);
  }

  .knr-manifesto__eyebrow-text {
    margin: 0;
    font-size: var(--knr-text-sm);
    letter-spacing: -0.24px;
    line-height: 20px;
  }

  .knr-manifesto__eyebrow-bar {
    width: 16px;
    height: 1px;
    background: var(--knr-color-white);
  }

  .knr-manifesto__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--knr-space-4);
  }

  .knr-manifesto__statement {
    width: 100%;
    font-size: 1.375rem;
    letter-spacing: -0.88px;
    line-height: 24px;
  }

  .knr-manifesto__statement > * {
    margin: 0;
  }

  .knr-manifesto__attribution {
    width: 100%;
    margin: 0;
    font-size: 0.625rem;
    letter-spacing: -0.4px;
    line-height: 12px;
  }

  /* Quick-shop is desktop-only (overlaps the section bottom-right). */
  .knr-manifesto__quickshop {
    display: none;
  }

  @media screen and (min-width: 750px) {
    .knr-manifesto__inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--knr-space-4);
      min-height: 720px;
      padding: 2.5rem;
    }

    .knr-manifesto__eyebrow {
      flex: 1 0 0;
    }

    .knr-manifesto__content {
      flex: 0 0 510px;
      max-width: 510px;
    }

    .knr-manifesto__statement {
      font-size: 2rem;
      letter-spacing: -1.28px;
      line-height: 40px;
    }

    .knr-manifesto__quickshop {
      position: absolute;
      inset-block-end: 0;
      inset-inline-end: 2.5rem;
      transform: translateY(50%);
      z-index: 3;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--knr-space-4);
      width: 561px;
      max-width: calc(100% - 5rem);
      padding: var(--knr-space-2) var(--knr-space-6) var(--knr-space-2) var(--knr-space-2);
      background: var(--knr-color-white);
      border: 0.8px solid var(--knr-color-surface-1);
      color: var(--knr-color-black);
    }

    .knr-manifesto__quickshop-product {
      display: flex;
      align-items: center;
      gap: var(--knr-space-4);
    }

    .knr-manifesto__quickshop-thumb {
      flex: 0 0 auto;
      width: 104px;
      height: 104px;
      object-fit: cover;
      display: block;
    }

    .knr-manifesto__quickshop-info {
      display: flex;
      flex-direction: column;
      gap: var(--knr-space-4);
    }

    .knr-manifesto__quickshop-title {
      margin: 0;
      font-size: 0.875rem;
      letter-spacing: -0.28px;
      line-height: 14px;
      text-transform: uppercase;
    }

    .knr-manifesto__quickshop-variants {
      display: flex;
      gap: var(--knr-space-2);
    }

    .knr-manifesto__quickshop-variant {
      padding: 0;
      background: transparent;
      border: 0;
      border-block-end: 0.8px solid transparent;
      color: var(--knr-color-black);
      font: inherit;
      font-size: var(--knr-text-sm);
      letter-spacing: -0.24px;
      line-height: 20px;
      cursor: pointer;
    }

    .knr-manifesto__quickshop-variant.is-selected {
      border-block-end-color: var(--knr-color-black);
    }

    .knr-manifesto__quickshop-price {
      margin: 0;
      font-size: 0.875rem;
      letter-spacing: -0.28px;
      line-height: 22px;
    }

    .knr-manifesto__quickshop-form {
      flex: 0 0 auto;
    }

    .knr-manifesto__quickshop-atc {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 200px;
      height: 56px;
      padding-inline: var(--knr-space-6);
      background: var(--knr-color-black);
      color: var(--knr-color-white);
      border: 0;
      border-radius: 2px;
      font-size: 0.8125rem;
      letter-spacing: -0.26px;
      cursor: pointer;
    }

    .knr-manifesto__quickshop-atc[disabled] {
      opacity: 0.5;
      cursor: not-allowed;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    function init() {
      document.querySelectorAll('[data-knr-quickshop]').forEach(function (root) {
        var idInput = root.querySelector('[data-knr-quickshop-id]');
        var priceEl = root.querySelector('[data-knr-quickshop-price]');
        var buttons = root.querySelectorAll('[data-knr-quickshop-variant]');
        buttons.forEach(function (btn) {
          btn.addEventListener('click', function () {
            buttons.forEach(function (b) {
              var on = b === btn;
              b.classList.toggle('is-selected', on);
              b.setAttribute('aria-checked', on ? 'true' : 'false');
            });
            if (idInput) idInput.value = btn.dataset.knrQuickshopVariant;
            if (priceEl) priceEl.textContent = btn.dataset.knrQuickshopVariantPrice;
          });
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
{% endjavascript %}

{% schema %}
{
  "name": "KNR Manifesto",
  "tag": "section",
  "class": "knr-section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Contenu géré par produit via le metafield knr.manifesto (métaobjet « KNR — Manifesto » : image + sur-titre + texte + attribution). La section ne s'affiche que si ce metafield est renseigné."
    }
  ],
  "presets": [
    {
      "name": "KNR Manifesto"
    }
  ]
}
{% endschema %}
