<script
  src="{{ 'knr-reviews.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<section
  class="knr-reviews"
  data-section-id="{{ section.id }}"
  data-knr-reviews
  data-knr-mock-url="{{ 'knr-product-data-mock.json' | asset_url }}"
  hidden
>
  <template data-knr-review-star>{{ 'knr-icon-star.svg' | inline_asset_content }}</template>

  <div class="knr-reviews__track" data-knr-reviews-track></div>

  <div class="knr-reviews__arrows">
    <button
      type="button"
      class="knr-reviews__arrow"
      data-knr-reviews-prev
      aria-label="{{ 'content.pagination.previous' | t }}"
    >
      {{- 'icon-chevron-left.svg' | inline_asset_content -}}
    </button>
    <button
      type="button"
      class="knr-reviews__arrow"
      data-knr-reviews-next
      aria-label="{{ 'content.pagination.next' | t }}"
    >
      {{- 'icon-chevron-right.svg' | inline_asset_content -}}
    </button>
  </div>
</section>

{% stylesheet %}
  .knr-reviews {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--knr-space-10);
    padding: 4rem var(--knr-space-6);
    background: var(--knr-color-surface-1);
    color: var(--knr-color-black);
    font-family: var(--knr-font-sans);
    text-align: center;
  }

  .knr-reviews[hidden] {
    display: none;
  }

  .knr-reviews__track {
    width: 100%;
    max-width: 800px;
  }

  .knr-reviews__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--knr-space-10);
  }

  .knr-reviews__item[hidden] {
    display: none;
  }

  .knr-reviews__rating {
    display: flex;
    align-items: center;
    gap: var(--knr-space-1);
  }

  .knr-reviews__stars {
    display: inline-flex;
    align-items: center;
    gap: var(--knr-space-1);
    color: var(--knr-color-accent);
  }

  .knr-reviews__star {
    display: inline-flex;
    width: 12px;
    height: 12px;
  }

  .knr-reviews__star svg {
    width: 100%;
    height: 100%;
  }

  .knr-reviews__star--off {
    opacity: 0.25;
  }

  .knr-reviews__author {
    color: var(--knr-color-accent);
    font-size: 0.625rem;
    letter-spacing: -0.4px;
    line-height: 12px;
  }

  .knr-reviews__quote {
    margin: 0;
    font-size: var(--knr-text-xl);
    letter-spacing: -0.48px;
    line-height: 32px;
  }

  .knr-reviews__arrows {
    display: flex;
    align-items: center;
    gap: var(--knr-space-4);
  }

  .knr-reviews__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    padding: 0;
    background: transparent;
    border: 0;
    color: var(--knr-color-black);
    cursor: pointer;
  }

  .knr-reviews__arrow[hidden] {
    display: none;
  }

  .knr-reviews__arrow svg {
    width: 16px;
    height: auto;
  }

  @media screen and (min-width: 750px) {
    .knr-reviews {
      padding: var(--knr-space-16) 2.5rem;
    }

    .knr-reviews__quote {
      font-size: 2rem;
      letter-spacing: -1.28px;
      line-height: 40px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "KNR Reviews",
  "tag": "section",
  "class": "knr-section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Carrousel d'avis alimenté par un mock JSON (assets/knr-product-data-mock.json) simulant la réponse d'une app d'avis pour ce produit. Pour passer en réel, pointez le fetch vers l'API de l'app. La section se masque si aucun avis n'est retourné."
    }
  ],
  "presets": [
    {
      "name": "KNR Reviews"
    }
  ]
}
{% endschema %}
